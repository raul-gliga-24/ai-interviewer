# Copy to .env.local and fill in the keys you have.
#
# Leave a key empty and its tier is shown as unavailable in the UI rather than
# failing when you pick it. At least one is needed.

# "Quality" tier — used when the user selects the smart/expensive option.
# Looks like: sk-ant-...
ANTHROPIC_API_KEY=

# "Fast & cheap" tier.
# Looks like: sk-...
DEEPSEEK_API_KEY=
